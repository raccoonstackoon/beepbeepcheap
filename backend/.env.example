# API Keys
ANTHROPIC_API_KEY=your_anthropic_key_here
SERPAPI_KEY=your_serpapi_key_here

# Database (leave empty for local SQLite, or use DATABASE_URL for PostgreSQL)
# Local development uses: backend/data/pricetracker.db
# Production on Render uses: /var/beepbeep-data/pricetracker.db (set in Render dashboard)

# Uploads directory
# UPLOADS_PATH=/var/beepbeep-data/uploads

# Frontend URL (for CORS in production)
FRONTEND_URL=https://beepbeep.cheap

# Node environment
NODE_ENV=development

# Apple Push Notifications (required for TestFlight/iPhone alerts)
# Create an Apple Push Notification service key in Apple Developer, base64 encode
# the .p8 file, then add these to your production host — never commit the key.
# APNS_KEY_BASE64=
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=cheap.beepbeep.app
# APNS_PRODUCTION=false
